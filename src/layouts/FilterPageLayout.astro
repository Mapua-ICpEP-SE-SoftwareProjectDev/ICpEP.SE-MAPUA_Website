---
import Layout from "./Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface Props {
    pageTitle: string;
    headerTag: string;
    headerTitle: string;
    filterLabel?: string;
    filterOptions: { label: string; value: string }[];
}

const {
    pageTitle,
    headerTag,
    headerTitle,
    filterLabel = "Filter by:",
    filterOptions,
} = Astro.props;
---

<Layout title={pageTitle}>
    <Navbar />

    <main class="flex-grow pt-12 pb-24">
        <!-- Dynamic Page Header -->
        <header class="max-w-7xl mx-auto px-6 pt-16 mb-12 text-center md:text-left">
            <span
                class="text-[#3B82F6] text-xs font-mono uppercase tracking-widest font-semibold mb-2 block"
            >
                {headerTag}
            </span>
            <h1 class="font-krona text-4xl md:text-5xl text-white">
                {headerTitle}
            </h1>
            <div class="w-24 h-1 bg-[#3B82F6] mx-auto md:mx-0 mt-6"></div>
        </header>

        <!-- Search and Filter Section -->
        <section class="max-w-7xl mx-auto px-6 mb-12">
            <div
                class="bg-[#151922] border border-[#2d3748] p-4 flex flex-col md:flex-row gap-4 justify-between items-center"
            >
                <div class="relative w-full md:w-1/2 lg:w-1/3">
                    <input
                        type="text"
                        id="search-input"
                        placeholder="Search..."
                        class="w-full bg-[#0B0C10] border border-[#2d3748] text-gray-300 px-4 py-2 pl-10 focus:outline-none focus:border-[#3B82F6] transition-colors font-suse text-sm"
                    />
                    <svg
                        class="w-4 h-4 text-gray-500 absolute left-3 top-1/2 -translate-y-1/2"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                        ></path>
                    </svg>
                </div>

                <div class="w-full md:w-auto flex items-center gap-4">
                    <span class="text-sm text-gray-400 font-suse"
                        >{filterLabel}</span
                    >
                    <select
                        id="category-filter"
                        class="bg-[#0B0C10] border border-[#2d3748] text-gray-300 px-4 py-2 focus:outline-none focus:border-[#3B82F6] transition-colors font-suse text-sm appearance-none cursor-pointer pr-8 relative"
                    >
                        {
                            filterOptions.map((option) => (
                                <option value={option.value}>
                                    {option.label}
                                </option>
                            ))
                        }
                    </select>
                </div>
            </div>
        </section>

        <!-- Grid Section -->
        <section class="max-w-7xl mx-auto px-6">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                <!-- Injected Cards go here -->
                <slot />
            </div>

            <div id="no-results" class="hidden text-center py-20">
                <p class="text-gray-400 font-suse text-lg">
                    No results found matching your criteria.
                </p>
            </div>
        </section>
    </main>

    <Footer />
</Layout>

<script>
    // This generic script handles filtering for ANY page using this layout.
    // It targets items with the generic '.filterable-item' class.
    const searchInput = document.getElementById(
        "search-input",
    ) as HTMLInputElement;
    const filterSelect = document.getElementById(
        "category-filter",
    ) as HTMLSelectElement;
    const items = document.querySelectorAll(
        ".filterable-item",
    ) as NodeListOf<HTMLElement>;
    const noResults = document.getElementById("no-results") as HTMLDivElement;

    function filterItems() {
        const query = searchInput.value.toLowerCase();
        const category = filterSelect.value;
        let visibleCount = 0;

        items.forEach((item) => {
            const title = item.getAttribute("data-title") || "";
            const tags = JSON.parse(item.getAttribute("data-tags") || "[]");

            const matchesSearch = title.includes(query);
            const matchesCategory =
                category === "all" || tags.includes(category);

            if (matchesSearch && matchesCategory) {
                item.style.display = "flex"; // Layout relies on flex column for cards
                visibleCount++;
            } else {
                item.style.display = "none";
            }
        });

        if (visibleCount === 0) {
            noResults.classList.remove("hidden");
        } else {
            noResults.classList.add("hidden");
        }
    }

    searchInput?.addEventListener("input", filterItems);

    filterSelect?.addEventListener("change", () => {
        filterItems();

        const newUrl = new URL(window.location.href);
        if (filterSelect.value === "all") {
            newUrl.searchParams.delete("category");
        } else {
            newUrl.searchParams.set("category", filterSelect.value);
        }
        window.history.replaceState({}, "", newUrl);
    });

    window.addEventListener("DOMContentLoaded", () => {
        const params = new URLSearchParams(window.location.search);
        const categoryParam = params.get("category");

        if (categoryParam) {
            const optionExists = Array.from(filterSelect.options).some(
                (opt) => opt.value === categoryParam,
            );
            if (optionExists) {
                filterSelect.value = categoryParam;
            }
        }

        filterItems();
    });
</script>
