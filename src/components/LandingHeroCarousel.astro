---
import { getCollection, type CollectionEntry } from "astro:content";

export interface Props {
    // Optional prop to override the default latest posts fetch
    posts?: CollectionEntry<'updates'>[];
}

const { posts } = Astro.props;

let selectedPosts: CollectionEntry<'updates'>[] = [];

// Apply maximum limit of 5 posts to either the prop override or the default fetch
if (posts && posts.length > 0) {
    selectedPosts = posts.slice(0, 5);
} else {
    const allUpdates = await getCollection("updates");
    selectedPosts = allUpdates
        .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
        .slice(0, 5);
}

const carouselSlides = selectedPosts.map((post) => ({
    image: `url('${post.data.image}')`,
    tags: post.data.tags,
    title: post.data.title,
    description: post.data.excerpt,
}));

const initialSlide = carouselSlides[0];
---

<section
    id="hero-carousel"
    data-slides={JSON.stringify(carouselSlides)}
    class="max-w-[1400px] mx-auto px-6 pt-16"
>
    <!-- Locked height prevents scrolling/shifting from variable text length -->
    <div
        class="border border-[#1e40af] flex flex-col lg:flex-row bg-icpep-card/80 backdrop-blur-sm h-[730px] lg:h-[580px] overflow-hidden"
    >
        <!-- Explicit height on mobile prevents the image from collapsing -->
        <div
            class="h-[305px] lg:h-full lg:w-19/30 bg-gradient-to-br from-gray-700 to-gray-900 relative shrink-0"
        >
            <div
                id="carousel-bg"
                class="absolute inset-0 bg-cover bg-center opacity-80 transition-all duration-500"
                style={`background-image: ${initialSlide?.image};`}
            >
            </div>
        </div>

        <div class="flex-grow lg:w-11/30 flex flex-col border-t lg:border-t-0 lg:border-l border-[#1e40af]">
            <div class="p-8 lg:p-10 flex-grow overflow-hidden flex flex-col justify-center">
                <div id="carousel-tags" class="flex flex-wrap gap-2 mb-4 lg:mb-6">
                    {
                        initialSlide?.tags.map((tag: string) => (
                            <span class="text-badge bg-[#2d3748]">
                                {tag}
                            </span>
                        ))
                    }
                </div>
                <!-- Line clamp restricts text lines to fit the fixed height -->
                <h1
                    id="carousel-title"
                    class="text-section-heading mt-0 mb-3 lg:mb-4 transition-opacity duration-300 line-clamp-4"
                >
                    {initialSlide?.title}
                </h1>
                <p
                    id="carousel-desc"
                    class="text-body-primary transition-opacity duration-300 line-clamp-3 lg:line-clamp-5"
                >
                    {initialSlide?.description}
                </p>
            </div>

            <div class="border-t border-[#1e40af] shrink-0">
                <div class="flex h-20 lg:h-24 border-b border-[#1e40af]">
                    <button
                        id="btn-prev"
                        class="w-1/2 flex items-center justify-center hover:bg-[#1e293b] transition-colors border-r border-[#1e40af]"
                    >
                        <svg
                            class="w-10 h-10 lg:w-12 lg:h-12 text-white"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M15 19l-7-7 7-7"></path></svg
                        >
                    </button>
                    <button
                        id="btn-next"
                        class="w-1/2 flex items-center justify-center hover:bg-[#1e293b] transition-colors"
                    >
                        <svg
                            class="w-10 h-10 lg:w-12 lg:h-12 text-white"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M9 5l7 7-7 7"></path></svg
                        >
                    </button>
                </div>

                <div
                    class="h-10 lg:h-12 flex items-center justify-center gap-6"
                    id="carousel-indicators"
                >
                    {
                        carouselSlides.map((_: unknown, i: number) => (
                            <button
                                data-index={i}
                                class={`carousel-indicator w-3 h-3 border transition-colors ${i === 0 ? "border-icpep-blue bg-icpep-blue" : "border-gray-500 bg-transparent"}`}
                            />
                        ))
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    interface Slide {
        image: string;
        tags: string[];
        title: string;
        description: string;
    }

    const carouselContainer = document.getElementById("hero-carousel");

    if (carouselContainer) {
        const slidesData = carouselContainer.getAttribute("data-slides");
        const carouselSlides: Slide[] = slidesData
            ? JSON.parse(slidesData)
            : [];

        let currentIndex: number = 0;
        let autoPlayInterval: number;

        const bgEl = document.getElementById("carousel-bg") as HTMLDivElement;
        const tagsEl = document.getElementById("carousel-tags") as HTMLDivElement;
        const titleEl = document.getElementById("carousel-title") as HTMLHeadingElement;
        const descEl = document.getElementById("carousel-desc") as HTMLParagraphElement;
        const prevBtn = document.getElementById("btn-prev") as HTMLButtonElement;
        const nextBtn = document.getElementById("btn-next") as HTMLButtonElement;
        const indicators = document.querySelectorAll(".carousel-indicator") as NodeListOf<HTMLButtonElement>;

        if (carouselSlides.length > 0) {
            function updateCarousel(index: number): void {
                const slide = carouselSlides[index];
                titleEl.style.opacity = "0";
                descEl.style.opacity = "0";

                setTimeout(() => {
                    bgEl.style.backgroundImage = slide.image;
                    titleEl.textContent = slide.title;
                    descEl.textContent = slide.description;

                    // Reuses the text-badge class without hardcoding typography utilities
                    tagsEl.innerHTML = slide.tags
                        .map(
                            (tag: string) =>
                                `<span class="text-badge bg-[#2d3748]">${tag}</span>`,
                        )
                        .join("");

                    titleEl.style.opacity = "1";
                    descEl.style.opacity = "1";
                }, 150);

                indicators.forEach(
                    (indicator: HTMLButtonElement, i: number) => {
                        if (i === index) {
                            indicator.classList.remove("border-gray-500", "bg-transparent");
                            indicator.classList.add("border-icpep-blue", "bg-icpep-blue");
                        } else {
                            indicator.classList.remove("border-icpep-blue", "bg-icpep-blue");
                            indicator.classList.add("border-gray-500", "bg-transparent");
                        }
                    },
                );
            }

            function startAutoPlay() {
                autoPlayInterval = window.setInterval(() => {
                    currentIndex =
                        currentIndex === carouselSlides.length - 1
                            ? 0
                            : currentIndex + 1;
                    updateCarousel(currentIndex);
                }, 7500); // 7.5 second scroll
            }

            function resetAutoPlay() {
                if (autoPlayInterval) window.clearInterval(autoPlayInterval);
                startAutoPlay();
            }

            prevBtn?.addEventListener("click", () => {
                currentIndex =
                    currentIndex === 0
                        ? carouselSlides.length - 1
                        : currentIndex - 1;
                updateCarousel(currentIndex);
                resetAutoPlay();
            });

            nextBtn?.addEventListener("click", () => {
                currentIndex =
                    currentIndex === carouselSlides.length - 1
                        ? 0
                        : currentIndex + 1;
                updateCarousel(currentIndex);
                resetAutoPlay();
            });

            indicators.forEach((indicator: HTMLButtonElement) => {
                indicator.addEventListener("click", (e: Event) => {
                    const target = e.target as HTMLButtonElement;
                    const indexStr = target.getAttribute("data-index");
                    if (indexStr) {
                        currentIndex = parseInt(indexStr, 10);
                        updateCarousel(currentIndex);
                        resetAutoPlay();
                    }
                });
            });

            // Initialize auto-scroll if there is more than 1 slide
            if (carouselSlides.length > 1) {
                startAutoPlay();
            }
        }
    }
</script>