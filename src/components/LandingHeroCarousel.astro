---
import { getCollection, type CollectionEntry } from "astro:content";

const allUpdates = await getCollection("updates");
const latestUpdates = allUpdates
    .sort((a: CollectionEntry<'updates'>, b: CollectionEntry<'updates'>) => b.data.date.valueOf() - a.data.date.valueOf())
    .slice(0, 5);

const carouselSlides = latestUpdates.map((post: CollectionEntry<'updates'>) => ({
    image: `url('${post.data.image}')`,
    tags: post.data.tags,
    title: post.data.title,
    description: post.data.excerpt,
}));

const initialSlide = carouselSlides[0];
---

<!-- Pass the JSON data into a data-attribute on the main container -->
<section
    id="hero-carousel"
    data-slides={JSON.stringify(carouselSlides)}
    class="max-w-[1400px] mx-auto px-6 pt-12"
>
    <div
        class="border border-[#1e40af] flex flex-col lg:flex-row bg-[#151922]/80 backdrop-blur-sm min-h-[500px]"
    >
        <div
            class="lg:w-2/3 bg-gradient-to-br from-gray-700 to-gray-900 relative"
        >
            <div
                id="carousel-bg"
                class="absolute inset-0 bg-cover bg-center opacity-80 transition-all duration-500"
                style={`background-image: ${initialSlide?.image};`}
            >
            </div>
        </div>

        <div class="lg:w-1/3 flex flex-col border-l border-[#1e40af]">
            <div class="p-10 flex-grow">
                <div id="carousel-tags" class="flex flex-wrap gap-2 mb-6">
                    {
                        initialSlide?.tags.map((tag: string) => (
                            <span class="bg-[#2d3748] text-xs px-3 py-1 font-semibold text-blue-200 uppercase">
                                {tag}
                            </span>
                        ))
                    }
                </div>
                <h1
                    id="carousel-title"
                    class="font-krona text-2xl lg:text-3xl mb-4 transition-opacity duration-300"
                >
                    {initialSlide?.title}
                </h1>
                <p
                    id="carousel-desc"
                    class="text-gray-300 text-sm leading-relaxed transition-opacity duration-300"
                >
                    {initialSlide?.description}
                </p>
            </div>

            <div class="border-t border-[#1e40af]">
                <div class="flex h-24 border-b border-[#1e40af]">
                    <button
                        id="btn-prev"
                        class="w-1/2 flex items-center justify-center hover:bg-[#1e293b] transition-colors border-r border-[#1e40af]"
                    >
                        <svg
                            class="w-12 h-12 text-white"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M15 19l-7-7 7-7"></path></svg
                        >
                    </button>
                    <button
                        id="btn-next"
                        class="w-1/2 flex items-center justify-center hover:bg-[#1e293b] transition-colors"
                    >
                        <svg
                            class="w-12 h-12 text-white"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M9 5l7 7-7 7"></path></svg
                        >
                    </button>
                </div>

                <div
                    class="h-12 flex items-center justify-center gap-6"
                    id="carousel-indicators"
                >
                    {
                        carouselSlides.map((_: unknown, i: number) => (
                            <button
                                data-index={i}
                                class={`carousel-indicator w-3 h-3 border transition-colors ${i === 0 ? "border-[#3B82F6] bg-[#3B82F6]" : "border-gray-500 bg-transparent"}`}
                            />
                        ))
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Standard script tag (no define:vars) allows full TypeScript inference -->
<script>
    // 1. Define the interface for strict typing
    interface Slide {
        image: string;
        tags: string[];
        title: string;
        description: string;
    }

    // 2. Safely grab the container and extract the data payload
    const carouselContainer = document.getElementById("hero-carousel");

    if (carouselContainer) {
        const slidesData = carouselContainer.getAttribute("data-slides");
        const carouselSlides: Slide[] = slidesData
            ? JSON.parse(slidesData)
            : [];

        let currentIndex: number = 0;

        // 3. Strongly type all DOM elements
        const bgEl = document.getElementById("carousel-bg") as HTMLDivElement;
        const tagsEl = document.getElementById(
            "carousel-tags",
        ) as HTMLDivElement;
        const titleEl = document.getElementById(
            "carousel-title",
        ) as HTMLHeadingElement;
        const descEl = document.getElementById(
            "carousel-desc",
        ) as HTMLParagraphElement;
        const prevBtn = document.getElementById(
            "btn-prev",
        ) as HTMLButtonElement;
        const nextBtn = document.getElementById(
            "btn-next",
        ) as HTMLButtonElement;
        const indicators = document.querySelectorAll(
            ".carousel-indicator",
        ) as NodeListOf<HTMLButtonElement>;

        if (carouselSlides.length > 0) {
            // Provide explicit types for function parameters (index: number)
            function updateCarousel(index: number): void {
                const slide = carouselSlides[index];
                titleEl.style.opacity = "0";
                descEl.style.opacity = "0";

                setTimeout(() => {
                    bgEl.style.backgroundImage = slide.image;
                    titleEl.textContent = slide.title;
                    descEl.textContent = slide.description;

                    // Provide explicit types for map parameters (tag: string)
                    tagsEl.innerHTML = slide.tags
                        .map(
                            (tag: string) =>
                                `<span class="bg-[#2d3748] text-xs px-3 py-1 font-semibold text-blue-200 uppercase">${tag}</span>`,
                        )
                        .join("");

                    titleEl.style.opacity = "1";
                    descEl.style.opacity = "1";
                }, 150);

                // Provide explicit types for forEach parameters
                indicators.forEach(
                    (indicator: HTMLButtonElement, i: number) => {
                        if (i === index) {
                            indicator.classList.remove(
                                "border-gray-500",
                                "bg-transparent",
                            );
                            indicator.classList.add(
                                "border-[#3B82F6]",
                                "bg-[#3B82F6]",
                            );
                        } else {
                            indicator.classList.remove(
                                "border-[#3B82F6]",
                                "bg-[#3B82F6]",
                            );
                            indicator.classList.add(
                                "border-gray-500",
                                "bg-transparent",
                            );
                        }
                    },
                );
            }

            prevBtn?.addEventListener("click", () => {
                currentIndex =
                    currentIndex === 0
                        ? carouselSlides.length - 1
                        : currentIndex - 1;
                updateCarousel(currentIndex);
            });

            nextBtn?.addEventListener("click", () => {
                currentIndex =
                    currentIndex === carouselSlides.length - 1
                        ? 0
                        : currentIndex + 1;
                updateCarousel(currentIndex);
            });

            indicators.forEach((indicator: HTMLButtonElement) => {
                // Provide explicit types for event listeners (e: Event)
                indicator.addEventListener("click", (e: Event) => {
                    const target = e.target as HTMLButtonElement;
                    const indexStr = target.getAttribute("data-index");
                    if (indexStr) {
                        currentIndex = parseInt(indexStr, 10);
                        updateCarousel(currentIndex);
                    }
                });
            });
        }
    }
</script>
