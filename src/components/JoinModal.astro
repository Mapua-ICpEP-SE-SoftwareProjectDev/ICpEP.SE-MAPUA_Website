---
export interface Props {
    isMemberClosed?: boolean;
    isOfficerClosed?: boolean;
}

// By default, we can set them to false, but you can override this where you import the component.
const { isMemberClosed = false, isOfficerClosed = false } = Astro.props;
---

<div 
    id="join-modal" 
    class="fixed inset-0 z-[100] flex items-center justify-center bg-icpep-dark/90 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300 px-6"
>
    <div class="bg-icpep-card border border-[#2d3748] w-full max-w-4xl p-8 relative flex flex-col md:flex-row gap-8 shadow-2xl">
        
        <!-- Close Button -->
        <button 
            id="close-modal-btn" 
            class="absolute top-4 right-4 text-gray-400 hover:text-white transition-colors z-10"
            aria-label="Close modal"
        >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
        </button>

        <!-- Member QR Section -->
        <div class="flex-1 flex flex-col items-center border border-[#2d3748] p-6 bg-icpep-dark relative overflow-hidden group hover:border-icpep-blue transition-colors duration-300">
            <h2 class="text-sub-heading mb-4 text-center">Member</h2>
            
            <div class="relative w-48 h-48 mb-6 bg-white p-2 flex items-center justify-center">
                <!-- Placeholder Member QR -->
                <img 
                    src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=MemberRegistration" 
                    alt="Member QR Code" 
                    class={`w-full h-full object-contain transition-all duration-300 ${isMemberClosed ? 'blur-md opacity-30' : ''}`} 
                />
                
                {isMemberClosed && (
                    <div class="absolute inset-0 flex flex-col items-center justify-center text-center p-3">
                        <svg class="w-8 h-8 text-icpep-blue mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                    </div>
                )}
            </div>

            {isMemberClosed ? (
                <div class="w-full flex flex-col items-center">
                    <p class="text-body-secondary text-xs mb-3 text-center">Membership is currently closed. Enter your Mapúa email to be notified when membership opens.</p>
                    <div class="flex w-full gap-2">
                        <input type="email" placeholder="Email address" class="w-full bg-icpep-card border border-[#2d3748] text-body-primary text-sm px-3 py-2 outline-none focus:border-icpep-blue" />
                        <button class="bg-icpep-blue text-nav-button text-white px-4 hover:bg-blue-600 transition-colors">Notify</button>
                    </div>
                </div>
            ) : (
                <p class="text-body-secondary text-center text-sm">Scan to fill out the membership registration form.</p>
            )}
        </div>

        <!-- Officer QR Section -->
        <div class="flex-1 flex flex-col items-center border border-[#2d3748] p-6 bg-icpep-dark relative overflow-hidden group hover:border-icpep-blue transition-colors duration-300">
            <h2 class="text-sub-heading mb-4 text-center">Officer</h2>
            
            <div class="relative w-48 h-48 mb-6 bg-white p-2 flex items-center justify-center">
                <!-- Placeholder Officer QR -->
                <img 
                    src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=OfficerRegistration" 
                    alt="Officer QR Code" 
                    class={`w-full h-full object-contain transition-all duration-300 ${isOfficerClosed ? 'blur-md opacity-30' : ''}`} 
                />
                
                {isOfficerClosed && (
                    <div class="absolute inset-0 flex flex-col items-center justify-center text-center p-3">
                        <svg class="w-8 h-8 text-icpep-blue mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                    </div>
                )}
            </div>

            {isOfficerClosed ? (
                <div class="w-full flex flex-col items-center">
                    <p class="text-body-secondary text-xs mb-3 text-center">Applications are currently closed. Enter your Mapúa email to be notified when they open.</p>
                    <div class="flex w-full gap-2">
                        <input type="email" placeholder="Email address" class="w-full bg-icpep-card border border-[#2d3748] text-body-primary text-sm px-3 py-2 outline-none focus:border-icpep-blue" />
                        <button class="bg-icpep-blue text-nav-button text-white px-4 hover:bg-blue-600 transition-colors">Notify</button>
                    </div>
                </div>
            ) : (
                <p class="text-body-secondary text-center text-sm">Scan to apply for an open executive position.</p>
            )}
        </div>

    </div>
</div>

<script>
    const modal = document.getElementById('join-modal');
    const closeBtn = document.getElementById('close-modal-btn');
    const openBtn = document.getElementById('join-btn');

    if (modal && closeBtn && openBtn) {
        openBtn.addEventListener('click', () => {
            modal.classList.remove('opacity-0', 'pointer-events-none');
            document.body.style.overflow = 'hidden'; // Prevents background scrolling
        });

        closeBtn.addEventListener('click', () => {
            modal.classList.add('opacity-0', 'pointer-events-none');
            document.body.style.overflow = '';
        });

        modal.addEventListener('click', (e) => {
            if (e.target === modal) {
                modal.classList.add('opacity-0', 'pointer-events-none');
                document.body.style.overflow = '';
            }
        });
    }
</script>

<!-- test -->