<footer class="mt-auto border-t border-[#2d3748] bg-icpep-card relative z-10">
    <div
        class="max-w-7xl mx-auto px-6 h-24 flex flex-col md:flex-row items-center justify-between gap-4"
    >
        <!-- Left Side: Logo and Copyright -->
        <div class="flex items-center gap-4">
            <img
                src="/logo.webp"
                class="w-10 h-10 flex-shrink-0"
                alt="ICpEP.SE Mapua Logo"
            />

            <span class="text-xs text-gray-400 font-suse tracking-wide">
                &copy; {new Date().getFullYear()} ICpEP.SE Mapúa University
            </span>
        </div>

        <!-- Right Side: Social Links -->
        <div
            class="flex items-center gap-8 text-xs text-gray-400 font-suse tracking-wide"
        >
            <a
                href="https://www.facebook.com/ICpEPseMapua"
                target="_blank"
                class="hover:text-icpep-blue transition-colors">Facebook</a
            >
            <a
                href="https://www.instagram.com/icpepsemapua"
                target="_blank"
                class="hover:text-icpep-blue transition-colors">Instagram</a
            >
            <a
                href="https://x.com/ICpEPseMapua"
                target="_blank"
                class="hover:text-icpep-blue transition-colors">Twitter</a
            >
        </div>
    </div>
</footer>
