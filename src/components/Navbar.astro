---

---

<header
    class="bg-[#0B0C10] border-b border-[#2d3748] fixed top-0 left-0 w-full z-50"
>
    <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
        <!-- Left Side: Logo and Main Nav -->
        <div class="flex items-center h-full gap-12">
            <!-- Logo Placeholder -->
            <a href="/">
                <div class="w-10 h-10 bg-[#3B82F6] rounded-full flex-shrink-0">
                </div>
            </a>

            <!-- Navigation Links -->
            <nav class="hidden md:flex h-full items-center gap-8">
                <!-- About Dropdown -->
                <div class="group h-full flex items-center cursor-pointer">
                    <a
                        href="about"
                        class="text-sm hover:text-[#3B82F6] transition-colors flex items-center gap-1"
                    >
                        About
                        <svg
                            class="w-3 h-3 transition-transform group-hover:rotate-180"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M19 9l-7 7-7-7"></path></svg
                        >
                    </a>
                    <!-- Full-width Dropdown Container -->
                    <div
                        class="absolute left-0 top-full w-full bg-[#0B0C10] border-b border-[#2d3748] hidden group-hover:block shadow-xl"
                    >
                        <div
                            class="max-w-7xl mx-auto px-6 py-8 flex gap-24 ml-[88px] text-sm text-gray-300"
                        >
                            <div class="flex flex-col gap-4">
                                <a href="#" class="hover:text-white">Vision</a>
                                <a href="#" class="hover:text-white">Mission</a>
                                <a href="#" class="hover:text-white"
                                    >Objectives</a
                                >
                                <a href="#" class="hover:text-white"
                                    >Core Values</a
                                >
                                <a href="#" class="hover:text-white">Sample 1</a
                                >
                            </div>
                            <div class="flex flex-col gap-4">
                                <a href="#" class="hover:text-white">History</a>
                                <a href="#" class="hover:text-white">Officers</a
                                >
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Updates Dropdown -->
                <div class="group h-full flex items-center cursor-pointer">
                    <a
                        href="updates"
                        class="text-sm hover:text-[#3B82F6] transition-colors flex items-center gap-1"
                    >
                        Updates
                        <svg
                            class="w-3 h-3 transition-transform group-hover:rotate-180"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M19 9l-7 7-7-7"></path></svg
                        >
                    </a>
                    <div
                        class="absolute left-0 top-full w-full bg-[#0B0C10] border-b border-[#2d3748] hidden group-hover:block shadow-xl"
                    >
                        <div
                            class="max-w-7xl mx-auto px-6 py-8 flex gap-24 ml-[180px] text-sm text-gray-300"
                        >
                            <div class="flex flex-col gap-4">
                                <a
                                    href="updates?category=Events"
                                    class="hover:text-white">Events</a
                                >
                                <a
                                    href="updates?category=Blogs"
                                    class="hover:text-white">Blogs</a
                                >
                                <a
                                    href="updates?category=Showcases"
                                    class="hover:text-white">Showcases</a
                                >
                                <a
                                    href="updates?category=News"
                                    class="hover:text-white">News</a
                                >
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Database Dropdown -->
                <div class="group h-full flex items-center cursor-pointer">
                    <a
                        href="database"
                        class="text-sm hover:text-[#3B82F6] transition-colors flex items-center gap-1"
                    >
                        Database
                        <svg
                            class="w-3 h-3 transition-transform group-hover:rotate-180"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M19 9l-7 7-7-7"></path></svg
                        >
                    </a>
                    <div
                        class="absolute left-0 top-full w-full bg-[#0B0C10] border-b border-[#2d3748] hidden group-hover:block shadow-xl"
                    >
                        <div
                            class="max-w-7xl mx-auto px-6 py-8 flex gap-24 ml-[280px] text-sm text-gray-300"
                        >
                            <div class="flex flex-col gap-4">
                                <a href="database?category=CPE101" class="hover:text-white">CPE101</a>
                                <a href="database?category=CPE120" class="hover:text-white">CPE120</a>
                                <a href="database?category=CPE117" class="hover:text-white">CPE117</a>
                                <a href="database?category=CPE200-1L" class="hover:text-white"
                                    >CPE200-1L</a
                                >
                                <a href="database?category=CPE120-1D" class="hover:text-white"
                                    >CPE120-1D</a
                                >
                            </div>
                        </div>
                    </div>
                </div>

                <a
                    href="merch"
                    class="text-sm hover:text-[#3B82F6] transition-colors"
                    >Merch</a
                >
                <a
                    href="faqs"
                    class="text-sm hover:text-[#3B82F6] transition-colors"
                    >FAQs</a
                >
            </nav>
        </div>

        <!-- Right Side: Action Buttons -->
        <div class="flex items-center gap-4">
            <a
                href="#"
                class="border border-white px-5 py-2 text-sm font-medium hover:bg-white hover:text-black transition-colors"
                >Contact</a
            >
            <a
                href="#"
                class="bg-white text-black px-5 py-2 text-sm font-medium hover:bg-gray-200 transition-colors"
                >Join Us</a
            >
        </div>
    </div>
</header>
