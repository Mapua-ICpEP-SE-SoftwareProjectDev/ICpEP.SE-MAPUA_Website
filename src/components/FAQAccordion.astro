---

<section class="max-w-4xl mx-auto px-6 py-20">
    <h2 class="font-krona text-2xl md:text-3xl mb-10 text-white">
        Frequently Asked Questions
    </h2>

    <div class="flex flex-col gap-4" id="faq-container">
        {
            faqs.map((faq, index) => (
                <details
                    class="faq-item group bg-[#151922] border border-[#2d3748] overflow-hidden"
                    // open={index === 1}
                >
                    <summary class="flex justify-between items-center p-5 cursor-pointer list-none font-krona text-sm md:text-base text-white hover:bg-[#1e293b] transition-colors">
                        {faq.question}
                        <span class="transition duration-300 group-open:rotate-180">
                            <svg
                                class="w-5 h-5 text-gray-400 group-hover:text-white"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M19 9l-7 7-7-7"
                                />
                            </svg>
                        </span>
                    </summary>
                    <div class="p-5 pt-0 text-sm text-gray-300 leading-relaxed border-t border-[#2d3748]/50 mt-2">
                        <p class="mt-4">{faq.answer}</p>
                    </div>
                </details>
            ))
        }
    </div>
</section>

<script>
    // TypeScript logic to ensure only one accordion is open at a time
    const faqItems = document.querySelectorAll(
        ".faq-item",
    ) as NodeListOf<HTMLDetailsElement>;

    faqItems.forEach((item) => {
        item.addEventListener("click", (e: Event) => {
            // Allow default summary behavior, but close others
            const target = e.currentTarget as HTMLDetailsElement;

            if (!target.open) {
                faqItems.forEach((otherItem) => {
                    if (otherItem !== target && otherItem.open) {
                        otherItem.open = false;
                    }
                });
            }
        });
    });
</script>

<style>
    /* Hides the default dropdown arrow for <details> in Safari/Chrome */
    details > summary::-webkit-details-marker {
        display: none;
    }
</style>
