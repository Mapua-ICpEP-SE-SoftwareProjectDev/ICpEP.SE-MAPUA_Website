---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import LandingHeroCarousel from "../components/LandingHeroCarousel.astro";
import FAQAccordion from "../components/FAQAccordion.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Home">
    <Navbar />

    <main class="flex-grow pt-12 pb-24">
        <LandingHeroCarousel/>

        <section class="max-w-4xl mx-auto px-6 py-32 text-center">
            <h2
                class="text-section-heading leading-relaxed underline decoration-icpep-blue decoration-4 underline-offset-[12px]"
            >
                The Premier Computer Engineering Organization of Mapua
                University
            </h2>

            <p
                class="text-body-primary mx-auto"
            >
                Description Here... Lorem ipsum dolor sit amet, consectetur
                adipiscing elit. Integer in accumsan nisl. Quisque id iaculis
                enim. Aenean consequat posuere purus, a porttitor metus luctus
                a. Phasellus eget metus eu dui maximus volutpat. Sed ut sagittis
                odio.
            </p>

            <div class="mt-10">
                <a
                    href="about"
                    class="border border-gray-500 text-gray-300 px-6 py-3 text-sm hover:border-white hover:text-white transition-colors"
                >
                    Learn More
                </a>
            </div>
        </section>

        <section class="max-w-4xl mx-auto px-6 py-20">
            <h2 class="text-section-heading">
                Frequently Asked Questions
            </h2>
            <FAQAccordion />
        </section>
    </main>

    <Footer />
</Layout>
