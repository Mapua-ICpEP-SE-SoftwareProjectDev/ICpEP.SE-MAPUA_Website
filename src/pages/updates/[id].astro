---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";

// 1. Generate a new path for every markdown file in the collection
export async function getStaticPaths() {
    const posts = await getCollection("updates");
    return posts.map((post) => ({
        params: { id: post.id },
        props: { post },
    }));
}

// 2. Get the specific post for this page
const { post } = Astro.props;

// 3. Render the markdown content to HTML
const { Content } = await render(post);
---

<Layout title={`${post.data.title} | ICpEP Mapua Updates`}>
    <Navbar />

    <main class="flex-grow pt-32 pb-24 px-6">
        <article class="max-w-4xl mx-auto">
            <!-- Back Button -->
            <a
                href="/updates"
                class="inline-flex items-center gap-2 text-sm text-gray-400 hover:text-[#3B82F6] transition-colors mb-8 group"
            >
                <svg
                    class="w-4 h-4 transition-transform group-hover:-translate-x-1"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg
                >
                Back to Updates
            </a>

            <!-- Post Header -->
            <header class="mb-12">
                <div class="flex flex-wrap gap-2 mb-6">
                    {
                        post.data.tags.map((tag: string) => (
                            <span class="bg-[#2d3748] text-[#3B82F6] text-xs px-3 py-1 font-semibold tracking-wider uppercase">
                                {tag}
                            </span>
                        ))
                    }
                </div>

                <h2
                    class="font-krona text-3xl md:text-5xl text-white leading-tight mb-6"
                >
                    {post.data.title}
                </h2>

                <div
                    class="flex items-center gap-4 text-sm text-gray-400 font-mono border-l-2 border-[#3B82F6] pl-4"
                >
                    <span>By {post.data.author.join(", ")}</span>
                    <span>•</span>
                    <span
                        >{
                            post.data.date
                                ? new Date(post.data.date).toLocaleDateString(
                                      "en-US",
                                      {
                                          year: "numeric",
                                          month: "long",
                                          day: "numeric",
                                      },
                                  )
                                : "Date TBA"
                        }</span
                    >
                </div>
            </header>

            <!-- Hero Image -->
            {
                post.data.image && (
                    <div class="w-full h-[400px] md:h-[500px] rounded-xl overflow-hidden mb-16 border border-[#2d3748]">
                        <img
                            src={post.data.image}
                            alt={post.data.title}
                            class="w-full h-full object-cover"
                        />
                    </div>
                )
            }

            <!-- Markdown Content Wrapper -->
            <div class="prose-content">
                <Content />
            </div>
        </article>
    </main>

    <Footer />
</Layout>

<style is:global>
    /* 
    Custom styling for the injected Markdown content.
    This ensures your markdown inherits your specific dark theme and fonts.
  */
    /* @reference "tailwindcss"; */
    @reference "../../styles/global.css";

    .prose-content {
        @apply text-gray-300 text-base md:text-lg leading-relaxed font-suse;
    }

    .prose-content h2,
    .prose-content h3,
    .prose-content h4 {
        @apply font-krona text-white mt-12 mb-6;
    }

    .prose-content h2 {
        @apply text-2xl md:text-3xl;
    }
    .prose-content h3 {
        @apply text-xl md:text-2xl;
    }

    .prose-content p {
        @apply mb-6;
    }

    .prose-content ul {
        @apply list-disc pl-6 mb-6 space-y-2 marker:text-[#3B82F6];
    }
    .prose-content ol {
        @apply list-decimal pl-6 mb-6 space-y-2 marker:text-[#3B82F6] font-mono;
    }

    .prose-content a {
        @apply text-[#3B82F6] hover:underline hover:text-blue-400 transition-colors;
    }

    .prose-content strong {
        @apply text-white font-bold;
    }

    .prose-content blockquote {
        @apply border-l-4 border-[#3B82F6] bg-[#151922] p-6 mb-6 italic text-gray-400 rounded-r-lg;
    }

    .prose-content code {
        @apply bg-[#151922] text-[#3B82F6] px-2 py-1 rounded text-sm font-mono border border-[#2d3748];
    }
</style>
