---
import { getCollection } from "astro:content";
import FilterPageLayout from "../layouts/FilterPageLayout.astro";
import FilterCard from "../components/FilterCard.astro";

const posts = await getCollection("updates");
const sortedPosts = posts.sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// Define the dropdown options specifically for the updates page
const updateFilters = [
    { label: "All Categories", value: "all" },
    { label: "Events", value: "Events" },
    { label: "Blogs", value: "Blogs" },
    { label: "Showcases", value: "Showcases" },
    { label: "News", value: "News" },
];
---

<FilterPageLayout
    pageTitle="Updates | ICpEP Mapua"
    headerTitle="Latest Updates"
    filterLabel="Filter by category:"
    filterOptions={updateFilters}
>
    {
        sortedPosts.map((post) => (
            <FilterCard
                title={post.data.title}
                url={`/updates/${post.id}`}
                date={
                    post.data.date
                        ? post.data.date.toLocaleDateString("en-US", {
                              year: "numeric",
                              month: "short",
                              day: "numeric",
                          })
                        : "TBA"
                }
                authors={
                    post.data.author && post.data.author.length > 0
                        ? post.data.author
                        : ["ICpEP Admin"]
                }
                tags={post.data.tags}
                image={post.data.image}
                excerpt={post.data.excerpt}
            />
        ))
    }
</FilterPageLayout>
