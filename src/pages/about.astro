    // {
    //     name: "Committee Head Name",
    //     role: "PROJECT DEVELOPMENT HEAD",
    //     isBOD: true,
    // },
    { name: "Joel Alexander R. Samaniego", role: "SOFTWARE DEVELOPMENT HEAD", isBOD: true },
    { name: "Genesis Jandrei T. Amante", role: "SOFTWARE DEVELOPMENT MEMBER"},
    { name: "Jairus Duane I. Mabini", role: "SOFTWARE DEVELOPMENT MEMBER"},
    { name: "Lance Joshua E. Samonte", role: "SOFTWARE DEVELOPMENT MEMBER"},
    { name: "Justin Andre D. De Leon", role: "SOFTWARE DEVELOPMENT MEMBER"},
    { name: "Keith Aaron R. Naval", role: "HARDWARE DEVELOPMENT HEAD" },
];

// 4. External Affairs
const externalBranch: Officer[] = [
    { name: "Mathew Daniel D. Reyes", role: "EXTERNAL VICE PRESIDENT", isBOD: true },
    { name: "Bon Mikell D.J. Matrimonio", role: "MEMBERSHIP HEAD" },
    { name: "OPEN", role: "MEMBERSHIP VICE HEAD" },
    { name: "Vincent Luiz S. Albaracin", role: "MEMBERSHIP MEMBER" },
    { name: "Victor Jerald D. Balagan", role: "MEMBERSHIP MEMBER" },
    { name: "Lars Elessar C. Cañaveral", role: "MEMBERSHIP MEMBER" },
    { name: "Alyzee Yvon N. Celaya", role: "EXTERNALS & PR HEAD" },
    { name: "Gabriel Vincent R. Martirez", role: "EXTERNALS & PR VICE HEAD" },
    { name: "Brenzo Ingo V. Venida", role: "EXTERNALS & PR MEMBER" },
    { name: "Gian Nicos I. Villaceran", role: "EXTERNALS & PR MEMBER" },
    { name: "Rafaello Emmanuel V. Rabusa", role: "4TH YEAR BATCH REP", isBOD:true },
    { name: "Santi Gabriel C. De Leon", role: "3RD YEAR BATCH REP", isBOD:true },
    { name: "Jett Nicolo V. Fulgencio", role: "2ND YEAR BATCH REP", isBOD:true },
    { name: "OPEN", role: "1ST YEAR BATCH REP", isBOD:true },
];
---

<Layout title="About Us">
    <Navbar />

    <main class="flex-grow pt-12 pb-24">
        <!-- Hero Section -->
        <section class="max-w-7xl mx-auto px-6 pt-16 md:pt-24 mb-24">
            <div
                class="flex flex-col-reverse md:flex-row items-center gap-12 lg:gap-20"
            >
                <!-- Left: Text Content -->
                <div
                    class="w-full md:w-1/2 flex flex-col items-start text-left"
                >
                    <h1
                        class="font-krona text-4xl md:text-5xl lg:text-6xl text-white leading-tight mb-6"
                    >
                        About The <br class="hidden lg:block" /> Organization
                    </h1>
                    <p
                        class="text-gray-300 text-sm md:text-base leading-relaxed max-w-lg mb-8"
                    >
                        We are the premier computer engineering student
                        organization at Mapúa University. Dedicated to fostering
                        innovation, academic excellence, and technical
                        proficiency, we build the bridge between classroom
                        theory and real-world application.
                    </p>
                    <div class="w-24 h-1 bg-icpep-blue"></div>
                </div>

                <!-- Right: Illustration -->
                <div class="w-full md:w-1/2 relative">
                    <!-- Decorative Background Glow -->
                    <div
                        class="absolute inset-0 bg-icpep-blue blur-[100px] opacity-20 rounded-full"
                    >
                    </div>

                    <!-- Image Container -->
                    <div
                        class="w-full h-[320px] lg:h-[420px] border border-[#2d3748] relative overflow-hidden group bg-icpep-card rounded-xl"
                    >
                        <!-- 
                            Replace the src with your actual image path. 
                            If the image is in your public folder, use src="/your-image-name.jpg" 
                        -->
                        <Image
                            src={aboutImage}
                            alt="ICpEP Mapua Engineering Team"
                            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                        />

                        <!-- Subtle blue overlay to blend the image into the dark theme -->
                        <div
                            class="absolute inset-0 bg-icpep-blue/10 pointer-events-none mix-blend-overlay"
                        >
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Vision & Mission (2-Column Grid) -->
        <section
            class="max-w-7xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8"
        >
            <!-- Vision: 2 Paragraphs -->
            <div
                id="vision"
                class="bg-icpep-card border border-[#2d3748] p-10 hover:border-icpep-blue transition-colors duration-300 flex flex-col"
            >
                <h2
                    class="font-krona text-2xl text-white mb-6 flex items-center gap-4"
                >
                    <svg
                        class="w-8 h-8 text-icpep-blue"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                        ></path></svg
                    >
                    Vision
                </h2>
                <div
                    class="text-gray-300 leading-relaxed text-sm md:text-base space-y-4 flex-grow"
                >
                    <p>
                        The Institute of Computer Engineers of the Philippines -
                        Student Edition, Mapúa University Chapter
                        (Mapúa-ICpEP.SE) envisions itself as the premier
                        academic and professional student organization for
                        Computer Engineering students at Mapúa University,
                        committed to developing competent, innovative, ethical,
                        and socially responsible future computer engineers who
                        contribute to the advancement of technology,
                        engineering, and society.
                    </p>
                    <p>
                        The Organization shall cultivate a collaborative
                        community that promotes academic excellence, technical
                        innovation, leadership, professional development, and
                        service while preparing its members to become globally
                        competitive Computer Engineering professionals.
                    </p>
                </div>
            </div>

            <!-- Mission: 6 Items -->
            <div
                id="mission"
                class="bg-icpep-card border border-[#2d3748] p-10 hover:border-icpep-blue transition-colors duration-300 flex flex-col"
            >
                <h2
                    class="font-krona text-2xl text-white flex items-center gap-4"
                >
                    <svg
                        class="w-8 h-8 text-icpep-blue"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
                        ></path></svg
                    >
                    Mission
                </h2>
                <p class="mb-6">
                    To achieve its Vision, the Organization shall:
                </p>
                <ul
                    class="space-y-4 text-gray-300 text-sm md:text-base flex-grow"
                >
                    <li class="flex items-start gap-3">
                        <span class="text-icpep-blue mt-1">▹</span> Promote academic
                        excellence by providing programs, resources, and collaborative
                        learning opportunities that enhance the academic performance
                        of Computer Engineering students.
                    </li>
                    <li class="flex items-start gap-3">
                        <span class="text-icpep-blue mt-1">▹</span> Develop the technical
                        competence of its members through engineering projects, technical
                        workshops, seminars, competitions, certifications, and other
                        industry-relevant activities.
                    </li>
                    <li class="flex items-start gap-3">
                        <span class="text-icpep-blue mt-1">▹</span> Cultivate leadership,
                        professionalism, and organizational responsibility by empowering
                        members to lead initiatives, manage projects, and actively
                        participate in organizational affairs.
                    </li>
                    <li class="flex items-start gap-3">
                        <span class="text-icpep-blue mt-1">▹</span> Foster collaboration,
                        camaraderie, and student well-being through meaningful activities
                        that strengthen teamwork, inclusivity, and holistic development.
                    </li>
                    <li class="flex items-start gap-3">
                        <span class="text-icpep-blue mt-1">▹</span> Build and strengthen
                        partnerships with the Institute of Computer Engineers of the
                        Philippines Student Edition, Mapúa University, alumni, industry
                        partners, professional organizations, and other academic institutions
                        to advance the interests of the Computer Engineering community.
                    </li>
                    <li class="flex items-start gap-3">
                        <span class="text-icpep-blue mt-1">▹</span> Uphold the principles
                        of integrity, accountability, ethical conduct, and professional
                        responsibility expected of Computer Engineering students and
                        future engineers.
                    </li>
                </ul>
            </div>
        </section>

        <!-- Objectives: 6 Items (Split into 2 columns) -->
        <section id="objectives" class="max-w-7xl mx-auto px-6 mb-8">
            <div
                class="bg-icpep-card border border-[#2d3748] p-10 hover:border-icpep-blue transition-colors duration-300"
            >
                <h2
                    class="font-krona text-2xl text-white text-center md:text-left"
                >
                    Objectives
                </h2>
                <p class="mb-8">
                    In pursuit of its Mission, the Organization shall strive to:
                </p>
                <ul
                    class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-6 text-gray-300 text-sm md:text-base"
                >
                    <li class="flex items-start gap-3">
                        <span class="text-icpep-blue mt-1">▹</span> Provide academic
                        assistance and learning opportunities that support the academic
                        success of its members.
                    </li>
                    <li class="flex items-start gap-3">
                        <span class="text-icpep-blue mt-1">▹</span> Organize technical,
                        professional, and leadership development activities that strengthen
                        the knowledge, competencies, and practical skills of Computer
                        Engineering students.
                    </li>
                    <li class="flex items-start gap-3">
                        <span class="text-icpep-blue mt-1">▹</span> Encourage active
                        participation in programs, competitions, conferences, seminars,
                        and initiatives organized by the National Organization, the
                        University, partner organizations, and other institutions
                        that contribute to the growth of its members.
                    </li>
                    <li class="flex items-start gap-3">
                        <span class="text-icpep-blue mt-1">▹</span> Develop leadership,
                        teamwork, discipline, and organizational involvement through
                        committees, projects, and student-led initiatives.
                    </li>
                    <li class="flex items-start gap-3">
                        <span class="text-icpep-blue mt-1">▹</span> Promote an organizational
                        culture founded on professionalism, collaboration, innovation,
                        continuous learning, and mutual respect.
                    </li>
                    <li class="flex items-start gap-3">
                        <span class="text-icpep-blue mt-1">▹</span> Represent and protect
                        the academic, professional, and general welfare of Computer
                        Engineering students within and outside the University
                    </li>
                </ul>
            </div>
        </section>

        <!-- Core Values: 8 Items (Grid of 4 columns) -->
        <section id="core-values" class="max-w-7xl mx-auto px-6 mb-24">
            <div
                class="bg-icpep-card border border-[#2d3748] p-10 hover:border-icpep-blue transition-colors duration-300"
            >
                <h2
                    class="font-krona text-2xl text-white text-center md:text-left"
                >
                    Core Values
                </h2>
                <p class="mb-8">
                    Every member of the Organization shall uphold the following
                    Core Values, which shall serve as the guiding principles for
                    all academic, organizational, professional, and personal
                    endeavors.
                </p>
                <div
                    class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8"
                >
                    <!-- Value 1 -->
                    <div class="border-l-2 border-icpep-blue pl-4">
                        <h3
                            class="font-bold text-white mb-2 text-sm font-krona"
                        >
                            Integrity
                        </h3>
                        <p class="text-xs text-gray-400 leading-relaxed">
                            Members shall uphold honesty, transparency,
                            accountability, and academic integrity in all their
                            actions. They shall conduct themselves ethically and
                            responsibly, recognizing that integrity is the
                            foundation of the engineering profession.
                        </p>
                    </div>
                    <!-- Value 2 -->
                    <div class="border-l-2 border-icpep-blue pl-4">
                        <h3
                            class="font-bold text-white mb-2 text-sm font-krona"
                        >
                            Commitment
                        </h3>
                        <p class="text-xs text-gray-400 leading-relaxed">
                            Members shall faithfully perform their duties and
                            responsibilities with dedication, discipline,
                            reliability, and initiative, contributing
                            meaningfully to the advancement of the Organization
                            and its mission.
                        </p>
                    </div>
                    <!-- Value 3 -->
                    <div class="border-l-2 border-icpep-blue pl-4">
                        <h3
                            class="font-bold text-white mb-2 text-sm font-krona"
                        >
                            Professionalism
                        </h3>
                        <p class="text-xs text-gray-400 leading-relaxed">
                            Members shall demonstrate maturity, respect,
                            competence, and accountability in their
                            interactions, reflecting the values expected of
                            Computer Engineering students and future engineering
                            professionals.
                        </p>
                    </div>
                    <!-- Value 4 -->
                    <div class="border-l-2 border-icpep-blue pl-4">
                        <h3
                            class="font-bold text-white mb-2 text-sm font-krona"
                        >
                            Innovation
                        </h3>
                        <p class="text-xs text-gray-400 leading-relaxed">
                            Members shall cultivate creativity, curiosity, and
                            critical thinking by embracing emerging
                            technologies, developing practical engineering
                            solutions, and continuously improving their
                            technical knowledge and skills.
                        </p>
                    </div>
                    <!-- Value 5 -->
                    <div class="border-l-2 border-icpep-blue pl-4">
                        <h3
                            class="font-bold text-white mb-2 text-sm font-krona"
                        >
                            Excellence
                        </h3>
                        <p class="text-xs text-gray-400 leading-relaxed">
                            Members shall pursue the highest standards of
                            academic achievement, technical competence,
                            leadership, and organizational service through
                            continuous learning and self-improvement.
                        </p>
                    </div>
                    <!-- Value 6 -->
                    <div class="border-l-2 border-icpep-blue pl-4">
                        <h3
                            class="font-bold text-white mb-2 text-sm font-krona"
                        >
                            Collaboration
                        </h3>
                        <p class="text-xs text-gray-400 leading-relaxed">
                            Members shall foster teamwork, inclusivity, open
                            communication, and mutual respect, recognizing that
                            successful engineering solutions are achieved
                            through collective effort and shared expertise.
                        </p>
                    </div>
                    <!-- Value 7 -->
                    <div class="border-l-2 border-icpep-blue pl-4">
                        <h3
                            class="font-bold text-white mb-2 text-sm font-krona"
                        >
                            Service
                        </h3>
                        <p class="text-xs text-gray-400 leading-relaxed">
                            Members shall use their knowledge, leadership, and
                            technical skills to serve the University, the
                            Computer Engineering community, and society,
                            embodying the engineer's responsibility to
                            contribute to the common good.
                        </p>
                    </div>
                    <!-- Value 8 -->
                    <div class="border-l-2 border-icpep-blue pl-4">
                        <h3
                            class="font-bold text-white mb-2 text-sm font-krona"
                        >
                            Ethical Responsibility
                        </h3>
                        <p class="text-xs text-gray-400 leading-relaxed">
                            Members shall exercise sound judgment and adhere to
                            the ethical standards of the engineering profession
                            by ensuring that technology is developed and applied
                            responsibly, securely, sustainably, and for the
                            benefit of humanity
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- History Section -->
        <!-- <section id="history" class="max-w-4xl mx-auto px-6 mb-24 text-center">
            <h2 class="font-krona text-2xl md:text-3xl text-white mb-8">
                Our History
            </h2>
            <div
                class="bg-icpep-card border border-[#2d3748] p-8 md:p-12 text-left hover:border-icpep-blue transition-colors duration-300"
            >
                <p
                    class="text-gray-300 leading-relaxed text-sm md:text-base mb-6"
                >
                    Established as the premier computer engineering student
                    organization, we have consistently championed the
                    integration of rigorous academic study with real-world
                    technical application. From our early days organizing small
                    study groups for microprocessor design to hosting
                    university-wide tech summits, our legacy is built on the
                    passion of generations of engineering students.
                </p>
                <p class="text-gray-300 leading-relaxed text-sm md:text-base">
                    Today, we continue to serve as the vital link between the
                    student body and the rapidly evolving tech industry,
                    ensuring that our members are not just passive learners, but
                    active creators and innovators in the digital landscape.
                </p>
            </div>
        </section> -->

        <!-- Officers Section -->
        <section
            id="officers"
            class="scroll-mt-24 max-w-7xl mx-auto px-6 mb-24"
        >
            <div class="text-center mb-16">
                <h2 class="text-section-heading mt-0 mb-4">
                    Organization Structure
                </h2>
                <p class="text-body-secondary">
                    The dedicated team leading Mapúa-ICpEP.SE.
                </p>
            </div>

            <!-- The Apex (Adviser & President) -->
            <div
                class="flex flex-col md:flex-row justify-center items-center gap-8 mb-16"
            >
                {
                    apexBranch.map((officer) => (
                        <div class="bg-icpep-card border border-[#2d3748] p-6 w-full max-w-sm text-center relative hover:-translate-y-1 hover:border-icpep-blue transition-all duration-300">
                            {officer.isBOD && (
                                <span class="absolute top-4 right-4 text-badge bg-[#2d3748]">
                                    B.O.D.
                                </span>
                            )}
                            <div class="w-24 h-24 bg-[#1e293b] rounded-full mx-auto mb-4 border-2 border-icpep-blue" />
                            <h3 class="text-card-title text-sm">
                                {officer.name}
                            </h3>
                            <p class="text-supertitle mt-2">{officer.role}</p>
                        </div>
                    ))
                }
            </div>

            <!-- The Executive Pillars (Stacked Rows) -->
            <div class="flex flex-col gap-16">
                <!-- 1. Internal Affairs Branch -->
                <div class="flex flex-col gap-6">
                    <div
                        class="border-b border-icpep-blue pb-2 mb-4 text-center"
                    >
                        <span class="text-supertitle text-icpep-blue text-lg"
                            >Internal Affairs</span
                        >
                    </div>
                    <!-- Flex wrap allows cards to sit in rows and center automatically -->
                    <div class="flex flex-wrap justify-center gap-6">
                        {
                            internalBranch.map((officer) => (
                                <div class="bg-icpep-card border border-[#2d3748] p-6 w-full sm:w-80 text-center relative hover:border-icpep-blue transition-colors duration-300">
                                    {officer.isBOD && (
                                        <span class="absolute top-4 right-4 text-badge bg-[#2d3748]">
                                            B.O.D.
                                        </span>
                                    )}
                                    <div class="w-16 h-16 bg-[#1e293b] rounded-full mx-auto mb-4 border border-icpep-blue" />
                                    <h3 class="text-card-title text-sm">
                                        {officer.name}
                                    </h3>
                                    <p class="text-supertitle mt-2">
                                        {officer.role}
                                    </p>
                                </div>
                            ))
                        }
                    </div>
                </div>

                <!-- 2. External Affairs Branch -->
                <div class="flex flex-col gap-6">
                    <div
                        class="border-b border-icpep-blue pb-2 mb-4 text-center"
                    >
                        <span class="text-supertitle text-icpep-blue text-lg"
                            >External Affairs</span
                        >
                    </div>
                    <div class="flex flex-wrap justify-center gap-6">
                        {
                            externalBranch.map((officer) => (
                                <div class="bg-icpep-card border border-[#2d3748] p-6 w-full sm:w-80 text-center relative hover:border-icpep-blue transition-colors duration-300">
                                    {officer.isBOD && (
                                        <span class="absolute top-4 right-4 text-badge bg-[#2d3748]">
                                            B.O.D.
                                        </span>
                                    )}
                                    <div class="w-16 h-16 bg-[#1e293b] rounded-full mx-auto mb-4 border border-icpep-blue" />
                                    <h3 class="text-card-title text-sm">
                                        {officer.name}
                                    </h3>
                                    <p class="text-supertitle mt-2">
                                        {officer.role}
                                    </p>
                                </div>
                            ))
                        }
                    </div>
                </div>

                <!-- 3. Project Development Branch -->
                <div class="flex flex-col gap-6">
                    <div
                        class="border-b border-icpep-blue pb-2 mb-4 text-center"
                    >
                        <span class="text-supertitle text-icpep-blue text-lg"
                            >Project Development</span
                        >
                    </div>
                    <div class="flex flex-wrap justify-center gap-6">
                        {
                            projDevBranch.map((officer) => (
                                <div class="bg-icpep-card border border-[#2d3748] p-6 w-full sm:w-80 text-center relative hover:border-icpep-blue transition-colors duration-300">
                                    {officer.isBOD && (
                                        <span class="absolute top-4 right-4 text-badge bg-[#2d3748]">
                                            B.O.D.
                                        </span>
                                    )}
                                    <div class="w-16 h-16 bg-[#1e293b] rounded-full mx-auto mb-4 border border-icpep-blue" />
                                    <h3 class="text-card-title text-sm">
                                        {officer.name}
                                    </h3>
                                    <p class="text-supertitle mt-2">
                                        {officer.role}
                                    </p>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>
        </section>
    </main>

    <Footer />
</Layout>
