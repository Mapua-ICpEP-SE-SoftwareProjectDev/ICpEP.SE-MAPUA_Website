    { name: "Kian Andrei C. Maglipac", role: "CREATIVES & DOCS MEMBER"},
    { name: "Francis Dominic G. Balana", role: "LOGISTICS & EVENTS HEAD", isBOD: true },
    { name: "Shawn G. Abuan", role: "LOGISTICS & EVENTS VICE HEAD" },
    { name: "Roxanne-Mae B. Rabimbi", role: "LOGISTICS & EVENTS MEMBER" },
    { name: "Thomas Joaquin L. Navarro", role: "LOGISTICS & EVENTS MEMBER"},
    { name: "Clayborne Benedict U. Orteza", role: "LOGISTICS & EVENTS MEMBER"},
    { name: "Ielahiah M. Tayag", role: "LOGISTICS & EVENTS MEMBER"},
    { name: "Enrico M. Gorospe", role: "LOGISTICS & EVENTS MEMBER"},
    { name: "Vince Allen Efren V. Canuto", role: "LOGISTICS & EVENTS MEMBER"},
